* text=auto
*.cs text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf
*.cmd text eol=crlf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.meta text eol=lf
*.asset text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
# Unity's YAML serializer emits trailing spaces for intentionally empty fields.
*.meta whitespace=-blank-at-eol
*.asset whitespace=-blank-at-eol
*.unity whitespace=-blank-at-eol
*.prefab whitespace=-blank-at-eol
*.fbx binary
*.glb binary
*.blend binary
*.png binary
