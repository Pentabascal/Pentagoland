# ───────── COMÚN ─────────
GUILD_ID=
DATA_DIR=./data
LOG_LEVEL=info

# ───────── TOKENS (uno por bot; NUNCA los compartas ni los subas a git) ─────────
WEB_BOT_TOKEN=
LINK_BOT_TOKEN=
SCP_BOT_TOKEN=

# IDs de aplicación (solo para `npm run invite`)
WEB_CLIENT_ID=
LINK_CLIENT_ID=
SCP_CLIENT_ID=

# ───────── BOT WEB ─────────
WEB_API_PORT=3101
# Origen de tu web (para CORS de los JSON públicos). Vacío = sin acceso desde navegadores.
WEB_ORIGIN=
MONITOR_INTERVAL_SEC=120

# ───────── BOT VÍNCULO ─────────
LINK_API_PORT=3102
# Secretos HMAC (mínimo 32 caracteres aleatorios, distintos entre sí)
API_SECRET_SERVER=
API_SECRET_WEB=
STATUS_STALE_SEC=180
PANEL_MIN_INTERVAL_SEC=45
PANEL_TICK_SEC=60

# ───────── BOT SENTINEL (SCP y auxiliar) ─────────
# URL base de la API del bot Vínculo (para /scp servidor). Vacío = desactivado.
LINK_API_URL=

# ───────── RED ─────────
API_HOST=127.0.0.1
# 1 si hay un proxy inverso (Caddy/nginx) delante
TRUST_PROXY=0
