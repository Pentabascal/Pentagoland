<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Callvote.LabAPI</id>
    <version>6.9.0+LabAPI</version>
    <title>Callvote</title>
    <authors>Unbistrackted,PatPeter</authors>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <license type="file">License.md</license>
    <licenseUrl>https://aka.ms/deprecateLicenseUrl</licenseUrl>
    <icon>Callvote.png</icon>
    <readme>NugetREADME.md</readme>
    <projectUrl>https://github.com/Unbistrackted/Callvote</projectUrl>
    <description>Callvote command like in the Source engine. Vote to kick users, restart round, or make your own custom votes.</description>
    <copyright>Modified BSD</copyright>
    <tags>LabAPI,EXILED,Callvote,SCPSL</tags>
    <repository type="git" url="https://github.com/Unbistrackted/Callvote" commit="6f56011af35760448b772c996eff52031e06fce2" />
    <dependencies>
      <group targetFramework=".NETFramework4.8">
        <dependency id="DiscordLab.Bot" version="2.5.0" exclude="Build,Analyzers" />
        <dependency id="Google.Protobuf" version="3.33.5" exclude="Build,Analyzers" />
        <dependency id="HintServiceMeow" version="5.4.1" exclude="Build,Analyzers" />
        <dependency id="Lib.Harmony" version="2.3.6" exclude="Build,Analyzers" />
        <dependency id="Northwood.LabAPI" version="1.1.5" exclude="Build,Analyzers" />
        <dependency id="RueI" version="3.1.2" exclude="Build,Analyzers" />
        <dependency id="System.Net.Http" version="4.3.4" exclude="Build,Analyzers" />
        <dependency id="YamlDotNet" version="16.0.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
    <frameworkAssemblies>
      <frameworkAssembly assemblyName="System.IO" targetFramework=".NETFramework4.8" />
      <frameworkAssembly assemblyName="System.Security.Cryptography.Algorithms" targetFramework=".NETFramework4.8" />
      <frameworkAssembly assemblyName="System.Security.Cryptography.Encoding" targetFramework=".NETFramework4.8" />
      <frameworkAssembly assemblyName="System.Security.Cryptography.Primitives" targetFramework=".NETFramework4.8" />
      <frameworkAssembly assemblyName="System.Security.Cryptography.X509Certificates" targetFramework=".NETFramework4.8" />
    </frameworkAssemblies>
  </metadata>
</package>